{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "SHOKH Design System",
    "brand": "SHOKH",
    "version": "1.1.0",
    "aesthetic": "Minimal Luxe (Cool Porcelain #F8F9FA, Charcoal #1F1F1F, Brushed Gold #C8A96B, Slate #6E7C7C)",
    "currency": "BDT (৳)",
    "syncedWith": "Figma Design System Layer & Tailwind CSS Config"
  },
  "color": {
    "bg": {
      "primary": { "value": "#F8F9FA", "type": "color", "description": "Main porcelain page canvas" },
      "card": { "value": "#FFFFFF", "type": "color", "description": "Elevated product cards and form panels" },
      "surface": { "value": "#EEF0F3", "type": "color", "description": "Product card media bg, subtle panels" },
      "subtle": { "value": "#E4E7EC", "type": "color", "description": "Hover surface, skeleton base, input fill" },
      "inverse": { "value": "#1F1F1F", "type": "color", "description": "Dark sections, announcement bar, footer" }
    },
    "text": {
      "primary": { "value": "#1F1F1F", "type": "color", "description": "Headings, primary body, prices" },
      "secondary": { "value": "#6E7C7C", "type": "color", "description": "Descriptions, labels, secondary nav" },
      "muted": { "value": "#8C969E", "type": "color", "description": "Placeholders, captions, disabled text" },
      "inverse": { "value": "#F8F9FA", "type": "color", "description": "Text on #1F1F1F dark backgrounds" }
    },
    "border": {
      "subtle": { "value": "#DCE0E6", "type": "color", "description": "Default 1px hairline borders & dividers" },
      "strong": { "value": "#CBD2D9", "type": "color", "description": "Input borders & hover dividers" },
      "focus": { "value": "#C8A96B", "type": "color", "description": "Active focus ring & selected variant border" }
    },
    "accent": {
      "primary": { "value": "#1F1F1F", "type": "color", "description": "Primary dark CTA button fill" },
      "primaryHover": { "value": "#333333", "type": "color", "description": "Primary CTA hover state" },
      "gold": { "value": "#C8A96B", "type": "color", "description": "Brushed gold brand accent (badges, Add to Bag, cart count, highlights)" },
      "goldHover": { "value": "#B59454", "type": "color", "description": "Brushed gold hover state" }
    },
    "semantic": {
      "success": { "value": "#15803D", "type": "color", "description": "In Stock, Delivered order status" },
      "successBg": { "value": "#F0FDF4", "type": "color", "description": "Success badge background" },
      "warning": { "value": "#B45309", "type": "color", "description": "Low Stock, Pending/Shipped status" },
      "warningBg": { "value": "#FFFBEB", "type": "color", "description": "Warning badge background" },
      "danger": { "value": "#B91C1C", "type": "color", "description": "Out of Stock, Cancelled order, form error" },
      "dangerBg": { "value": "#FEF2F2", "type": "color", "description": "Danger badge background" },
      "info": { "value": "#1D4ED8", "type": "color", "description": "Confirmed order status, chart accent" },
      "infoBg": { "value": "#EFF6FF", "type": "color", "description": "Info badge background" }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": { "value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "type": "fontFamily" },
      "mono": { "value": "'JetBrains Mono', ui-monospace, SFMono-Regular, monospace", "type": "fontFamily" }
    },
    "scale": {
      "display": { "fontSize": "48px", "lineHeight": "1.08", "letterSpacing": "-0.03em", "fontWeight": "500" },
      "displayMobile": { "fontSize": "32px", "lineHeight": "1.12", "letterSpacing": "-0.025em", "fontWeight": "500" },
      "h1": { "fontSize": "32px", "lineHeight": "1.2", "letterSpacing": "-0.02em", "fontWeight": "500" },
      "h2": { "fontSize": "24px", "lineHeight": "1.25", "letterSpacing": "-0.015em", "fontWeight": "500" },
      "h3": { "fontSize": "18px", "lineHeight": "1.35", "letterSpacing": "-0.01em", "fontWeight": "500" },
      "body": { "fontSize": "14px", "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" },
      "bodyLg": { "fontSize": "16px", "lineHeight": "1.6", "letterSpacing": "0em", "fontWeight": "400" },
      "caption": { "fontSize": "12px", "lineHeight": "1.4", "letterSpacing": "0.01em", "fontWeight": "400" },
      "overline": { "fontSize": "11px", "lineHeight": "1.3", "letterSpacing": "0.1em", "fontWeight": "500", "textTransform": "uppercase" }
    }
  },
  "spacing": {
    "unit": "4px",
    "containerMax": "1280px",
    "gutterDesktop": "24px",
    "gutterMobile": "16px",
    "sectionYDesktop": "80px",
    "sectionYMobile": "48px"
  },
  "radius": {
    "none": "0px",
    "xs": "2px",
    "sm": "4px",
    "md": "6px",
    "full": "9999px"
  },
  "shadow": {
    "none": "none",
    "drawer": "0 12px 32px rgba(0, 0, 0, 0.08)",
    "dropdown": "0 4px 16px rgba(0, 0, 0, 0.06)"
  },
  "motion": {
    "durationFast": "150ms",
    "durationBase": "220ms",
    "durationSlow": "320ms",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "breakpoints": {
    "mobileCanvas": "390px",
    "sm": "640px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px",
    "desktopCanvas": "1440px"
  }
}
